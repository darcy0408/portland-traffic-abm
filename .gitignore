# Data and generated outputs (kept out of version control)
data/
outputs/

# Cached street network graphs
*.graphml

# OSMnx HTTP response cache (raw OpenStreetMap downloads)
cache/

# Python caches and compiled files
__pycache__/
*.pyc

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Secrets / local environment variables
.env

# Personal, machine-specific Claude Code settings (commands/ ARE shared, this is not)
.claude/settings.local.json

# Private project notes — never commit
CLAUDE.local.md

# Class/program reference notes: contain stipend amounts, emails, Zoom links, and
# other students' names. Useful context for the assistant, not for a public repo.
REU_reference.md
reference/

# Private work-ahead sandbox: exploratory prototypes not ready for the shared repo
# (e.g. the weather second-surface work). Promote files into src/ when they are ready.
sandbox/

# Session concurrency guard: a per-working-dir lock (/start-session writes it,
# /close-session removes it) and any worktrees created for parallel sessions.
# Session-local state, never commit.
.claude/.session-lock
.claude/worktrees/

# Private working notes, drafts, and unreviewed results: kept on local disk at
# Documents/portland-abm-private, never in this public repo.
.claude/
CHAPTER*.md
PROGRESS.md
SESSION_NOTES.md
RESULTS_LEDGER.md
ROADMAP.md
SIGSPATIAL_*.md
LITERATURE_SWEEP_*.md
*_RESULTS.md
SCALEUP_*.md
LANES_EXPERIMENT.md
NOISE_TNM_DESIGN.md
paper/
